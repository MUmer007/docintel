ENVIRONMENT=development

LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=openai/gpt-oss-120b

LLM_ANTHROPIC_API_KEY=
LLM_JUDGE_MODEL=claude-sonnet-4-6

LLM_OPENAI_API_KEY=

RETRIEVAL_CHROMA_PERSIST_DIR=data/chroma
RETRIEVAL_COLLECTION_NAME=docintel_chunks
RETRIEVAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K_FINAL=5
RETRIEVAL_USE_HYBRID_SEARCH=true
RETRIEVAL_USE_RERANKER=true

OTEL_SERVICE_NAME=docintel
OTEL_OTLP_ENDPOINT=
OTEL_LOG_LEVEL=INFO
